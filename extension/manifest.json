{
  "manifest_version": 3,
  "name": "Registry Route — Secretary of State Lookup",
  "short_name": "Registry Route",
  "version": "1.0.0",
  "description": "Jump straight to any state's Secretary of State business search. Type a name, pick a state, or right-click a name on any page.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Registry Route — Secretary of State lookup"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "offscreen"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Open Registry Route"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
